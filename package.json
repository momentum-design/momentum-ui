{
  "name": "momentum-ui",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/momentum-design/momentum-ui.git"
  },
  "engines": {
    "node": "24.18.x"
  },
  "packageManager": "yarn@1.22.22",
  "browserslist": [
    ">0.25%",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "bootstrap": "yarn install --frozen-lockfile && yarn --cwd web-components install --frozen-lockfile",
    "bootstrap:clean": "yarn clean && yarn bootstrap",
    "build": "yarn build:all",
    "build:all": "run-s build:tokens build:utils build:icons build:icons-rebrand build:core build:react build:charts build:wc build:www",
    "build:core": "yarn --cwd core build:lib",
    "build:charts": "yarn --cwd charts build:lib",
    "build:icons": "yarn --cwd icons build:lib",
    "build:icons-rebrand": "yarn --cwd icons-rebrand build:lib",
    "build:react": "yarn --cwd react build:lib",
    "build:wc": "yarn --cwd web-components dist",
    "build:wc:sonar": "yarn --cwd web-components sonar",
    "build:tokens": "yarn --cwd tokens build:lib",
    "build:utils": "yarn --cwd utils build:lib",
    "build:data": "rimraf ./data && node ./tools/generateComponentsData.js",
    "build:www": "yarn --cwd www build",
    "build:www-dist": "yarn --cwd www build:dist",
    "check:alignment": "node ./tools/checkDependencyAlignment.js",
    "serve:core": "yarn --cwd core open:dist",
    "ci:publish": "yarn release",
    "ci:test": "yarn ci:test:icons && yarn test:icons-rebrand && yarn ci:test:core && yarn ci:test:react && yarn ci:test:charts",
    "ci:test:core": "yarn --cwd core test",
    "ci:test:core:percy": "yarn --cwd core test:percy",
    "ci:test:icons": "yarn --cwd icons test",
    "ci:test:icons-rebrand": "yarn --cwd icons-rebrand test",
    "ci:test:react": "yarn --cwd react test:CI",
    "ci:test:wc": "yarn --cwd web-components test:ci",
    "ci:test:tokens": "yarn --cwd tokens test",
    "ci:test:react:percy": "yarn --cwd react test:percy",
    "ci:test:percy": "yarn ci:test:icons && yarn test:icons-rebrand && yarn ci:test:core:percy && yarn ci:test:react",
    "ci:test:charts": "yarn --cwd charts test:CI",
    "ci:test:www": "yarn --cwd www test:CI",
    "cypress:verify": "cypress verify",
    "clean": "rimraf node_modules/ **/node_modules/",
    "commit": "npx git-cz",
    "data": "yarn build:data && yarn data:pushToDB",
    "data:pushToDB": "node ./tools/postComponentsToDB.js",
    "lint:all": "run-s lint:tokens lint:icons lint:icons-rebrand lint:core lint:react lint:charts lint:www lint:wc",
    "lint:icons": "yarn --cwd icons lint",
    "lint:icons-rebrand": "yarn --cwd icons-rebrand lint",
    "lint:core": "yarn --cwd core lint",
    "lint:react": "yarn --cwd react lint",
    "lint:charts": "yarn --cwd charts lint",
    "lint:www": "yarn --cwd www lint",
    "lint:wc": "yarn --cwd web-components eslint .",
    "lint:tokens": "yarn --cwd tokens lint",
    "publish:www": "node ./tools/publishWebsite.js",
    "publish:icons": "cd ./icons && yarn updateIconDatabase && yarn uploadIconSvgs",
    "release": "./tools/release.sh",
    "storybook:wc-dist": "yarn --cwd web-components storybook:dist",
    "start:all": "run-p start:core start:react start:charts start:www start:wc",
    "start:core": "yarn --cwd core start",
    "start:react": "yarn --cwd react start",
    "start:tokens": "yarn --cwd tokens start",
    "start:charts": "yarn --cwd charts start",
    "start:www": "yarn --cwd www start",
    "start:wc": "yarn --cwd web-components dev",
    "test:all": "run-s test:charts test:react test:wc",
    "test:react": "yarn --cwd react test:CI",
    "test:tokens": "yarn --cwd tokens test",
    "test:wc": "yarn --cwd web-components test --runInBand",
    "test:charts": "yarn --cwd charts test:CI"
  },
  "devDependencies": {
    "@babel/cli": "7.28.6",
    "@babel/core": "7.28.6",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/node": "^7.28.0",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-react-constant-elements": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/runtime": "^7.28.6",
    "@cfaester/enzyme-adapter-react-18": "0.8.0",
    "@cypress/webpack-preprocessor": "6.0.4",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@percy/cli": "1.32.7",
    "@percy/cypress": "3.1.9",
    "@eslint/js": "^9.39.2",
    "@semantic-release/changelog": "^3.0.2",
    "@semantic-release/exec": "^3.3.2",
    "@semantic-release/git": "^7.0.7",
    "autoprefixer": "^10.4.21",
    "aws-sdk": "^2.538.0",
    "babel-jest": "30.2.0",
    "babel-loader": "^8.4.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "chalk": "^4.1.2",
    "copy-webpack-plugin": "13.0.0",
    "core-js": "^3.46.0",
    "css-loader": "7.1.2",
    "cypress": "15.21.0",
    "enzyme": "3.11.0",
    "eslint": "^9.39.2",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-cypress": "^5.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "fs-extra": "^11.3.2",
    "git-url-parse": "^11.1.2",
    "html-webpack-plugin": "5.6.6",
    "globals": "^16.5.0",
    "husky": "^4.2.3",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "lerna": "8.2.4",
    "mime": "^2.4.4",
    "mini-css-extract-plugin": "2.10.2",
    "node-sass-tilde-importer": "^1.0.2",
    "npm-run-all2": "9.0.3",
    "postcss": "8.4.47",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-loader": "^8.2.0",
    "postcss-scss": "4.0.9",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "regenerator-runtime": "^0.14.1",
    "remark-parse": "^6.0.3",
    "rimraf": "^6.0.1",
    "sass": "1.83.4",
    "sass-loader": "10.5.2",
    "semantic-release": "^15.13.24",
    "semantic-release-monorepo": "^6.1.1",
    "serve": "14.2.6",
    "style-loader": "^4.0.0",
    "stylelint": "15.11.0",
    "unified": "^7.1.0",
    "webex": "^1.80.1",
    "webpack": "5.104.1",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.3",
    "webpack-merge": "6.0.1",
    "wait-on": "^7.2.0"
  },
  "resolutions": {
    "cheerio": "1.0.0-rc.12"
  },
  "workspaces": {
    "packages": [
      "./core",
      "./charts",
      "./icons",
      "./icons-rebrand",
      "./illustrations",
      "./animations",
      "./react",
      "./tokens",
      "./utils",
      "./www"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "dependencies": {
    "axios": "^0.30.2",
    "lodash": "^4.17.15",
    "md5": "^2.3.0",
    "proxy-agent": "^4.0.1"
  }
}
