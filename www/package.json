{
  "name": "momentum-design",
  "version": "229.0.0",
  "description": "Client and server for momentum.design",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/momentum-design/momentum-ui.git"
  },
  "bugs": {
    "url": "https://github.com/momentum-design/momentum-ui/issues"
  },
  "scripts": {
    "analyze-bundle": "node ../tools/runRootTool.js webpack --config webpack.config.prod.js --profile --json | node ../tools/runRootTool.js webpack-bundle-analyzer",
    "pre-build": "node ../tools/runRootTool.js run-s remove-dist build:examples build:react build:create:component-list",
    "build": "node ../tools/runRootTool.js run-s remove-dist build:examples build:react build:create:component-list build:dist",
    "build:watch": "yarn build && yarn open:dist",
    "build:examples": "node ../tools/runRootTool.js rimraf ./client/examples && node ../tools/runRootTool.js babel-node ./tools/copyExamples.js && yarn build:codePen && yarn build:markdown",
    "build:codePen": "node ./tools/buildCodePen",
    "build:markdown": "node ./tools/buildMarkDown",
    "build:react": "cd ../react && yarn build:lib",
    "build:create:component-list": "node ../tools/runRootTool.js rimraf ./client/data && node ../tools/runRootTool.js babel-node ./tools/createComponentList.js",
    "build:dist": "node ../tools/runRootTool.js webpack --config webpack.config.prod.js",
    "clean:dist": "yarn remove-dist && mkdir dist",
    "clean:install": "node ../tools/runRootTool.js rimraf node_modules && yarn cache clean && yarn install",
    "lint": "node ../tools/runRootTool.js eslint webpack.config.* client server tools --color",
    "open:client": "node ../tools/runRootTool.js webpack serve --config webpack.config.dev.js",
    "open:dev": "node ../tools/runRootTool.js webpack serve --config webpack.config.dev.js",
    "open:dist": "node ../tools/runRootTool.js serve -s dist -l 3100",
    "remove-dist": "node ../tools/runRootTool.js rimraf ./dist",
    "run:cypress": "node ../tools/runRootTool.js cypress run",
    "start": "node ../tools/runRootTool.js run-s build:examples build:create:component-list open:dev",
    "start-message": "node ../tools/runRootTool.js babel-node tools/startMessage.js",
    "start:dev": "yarn open:dev",
    "start:server": "node -r esm server/server.js",
    "start:app": "node ../tools/runRootTool.js run-s build open:dist",
    "test:CI": "node ../tools/runRootTool.js run-p --race start:app test:CI:cypress",
    "test:CI:cypress": "node ../tools/runRootTool.js wait-on http://127.0.0.1:3100 && yarn run:cypress"
  },
  "author": "Cisco Systems, Inc.",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@momentum-ui/core": "^19.15.30",
    "@momentum-ui/react": "^23.27.11",
    "@momentum-ui/tokens": "^1.7.1",
    "@momentum-ui/utils": "^6.2.15",
    "ash-motion": "^1.0.1",
    "connected-react-router": "^6.9.3",
    "dom-helpers": "^3.4.0",
    "dotenv": "^6.1.0",
    "esm": "^3.2.25",
    "formidable": "^3.5.4",
    "lodash": "^4.18.0",
    "marked": "^4.3.0",
    "moment": "^2.24.0",
    "moment-timezone": "^0.5.14",
    "object-assign": "^4.1.0",
    "prop-types": "15.8.1",
    "query-string": "^9.5.0",
    "react": "18.3.1",
    "react-aria-modal": "^5.0.2",
    "react-context-toolbox": "^2.0.2",
    "react-dom": "18.3.1",
    "react-focus-lock": "^2.13.7",
    "react-ga": "^2.5.6",
    "react-media": "^1.8.0",
    "react-redux": "^7.2.9",
    "react-router-dom": "^5.3.4",
    "react-uid": "^2.4.0",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2"
  },
  "devDependencies": {
    "body-parser": "^1.18.3",
    "escape-html": "^1.0.3",
    "express": "^4.16.3",
    "file-save": "^0.2.0",
    "history": "4.7.2",
    "lodash-es": "^4.17.11",
    "mongoose": "^7.8.12",
    "mongoose-findorcreate": "^4.0.0",
    "mongoose-unique-validator": "^4.0.1",
    "prismjs": "^1.15.0",
    "prompt": "1.0.0",
    "raf": "~3.3.2",
    "react-virtualized": "^9.21.2",
    "react-virtualized-auto-sizer": "^1.0.2",
    "react-window": "^1.8.5",
    "redux-immutable-state-invariant": "^2.1.0"
  }
}
