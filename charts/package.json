{
  "name": "@momentum-ui/charts",
  "version": "1.0.0-beta.14",
  "description": "momentum style chart library",
  "main": "src/lib/index.js",
  "module": "es/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/momentum-design/momentum-ui.git"
  },
  "author": "Cisco Momentum Team",
  "license": "MIT",
  "scripts": {
    "build": "yarn build:lib",
    "build:app": "node ../tools/runRootTool.js webpack --config config/webpack.config.prod.js",
    "build:lib": "node ../tools/runRootTool.js run-s build:modules build:bundle build:css",
    "build:modules": "node tools/lib/build-modules.js",
    "build:bundle": "node ../tools/runRootTool.js webpack --config config/webpack.config.libProd.js",
    "build:css": "node tools/lib/build-css.js",
    "clean": "node ../tools/runRootTool.js rimraf dist",
    "ci:publishCDN": "yarn pushToS3",
    "pushToS3": "node ../tools/pushToS3.js --library=charts",
    "deploy:build": "yarn run build:lib",
    "dist": "node ../tools/runRootTool.js run-s clean build:lib lint",
    "lint": "node ../tools/runRootTool.js eslint src",
    "test:CI": "node ../tools/runRootTool.js jest --maxWorkers=2 --bail --watchman=false",
    "start": "node ../tools/runRootTool.js webpack serve --config config/webpack.config.dev.js",
    "g": "node tools/init/init.js",
    "test": "node ../tools/runRootTool.js jest --watchman=false",
    "prepublishOnly": "yarn build:lib",
    "ci:postpublish": "node ../tools/postpublish.js"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "<rootDir>/config/jest.setup.js"
    ],
    "roots": [
      "<rootDir>/src/lib/"
    ],
    "moduleFileExtensions": [
      "js"
    ],
    "moduleNameMapper": {
      "^@lib/(.*)$": "<rootDir>/src/lib/$1",
      "@momentum-ui/charts": "<rootDir>/src/lib"
    },
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(d3|d3-[^/]+|internmap|delaunator|robust-predicates)/)"
    ],
    "snapshotSerializers": []
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "d3": "^7.9.0"
  },
  "peerDependencies": {
    "core-js": "^3.1.4"
  },
  "devDependencies": {}
}
